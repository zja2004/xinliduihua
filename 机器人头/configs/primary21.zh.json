  "questions": [
    {
      "id": "Q01",
      "text": "我想安静下来时，心里还是有点乱。",
      "dimension": "tension",
      "topic": "安静下来"
    },
    {
      "id": "Q02",
      "text": "我会觉得嘴巴干干的。",
